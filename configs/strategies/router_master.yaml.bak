name: router_master
description: 'Master router: auto-select estimator + controller from full candidate
  set'
data:
  symbol: SPY
  source: databento
  price_col: close
target_vol: 0.1
rebalance_freq: daily
roll_window: 252
weight_min: 0.0
weight_max: 1.5
cost_bps: 5.0
vol_ann: 252
router:
  enabled: true
  default_pair: ewma__naive
  params:
    sticky_period: 5
    min_performance_obs: 20
    use_perf_weight: true
  pairs:
  - name: ewma__naive
    estimator:
      class: src.estimators.ewma.EWMA
      params:
        halflife: 20
        vol_ann: 252
    controller:
      class: src.controllers.naive_scaling.NaiveScaling
      params: {}
  - name: ewma__constant
    estimator:
      class: src.estimators.ewma.EWMA
      params:
        halflife: 20
        vol_ann: 252
    controller:
      class: src.controllers.constant_weight.ConstantWeight
      params: {}
  - name: ewma__variance
    estimator:
      class: src.estimators.ewma.EWMA
      params:
        halflife: 20
        vol_ann: 252
    controller:
      class: src.controllers.variance_scaling.VarianceScaling
      params: {}
  - name: ewma__regime
    estimator:
      class: src.estimators.ewma.EWMA
      params:
        halflife: 20
        vol_ann: 252
    controller:
      class: src.controllers.regime_controller.RegimeSwitchController
      params: {}
  - name: ewma__vol_clip
    estimator:
      class: src.estimators.ewma.EWMA
      params:
        halflife: 20
        vol_ann: 252
    controller:
      class: src.controllers.vol_target_clip.VolTargetClip
      params: {}
  - name: ewma__drawdown
    estimator:
      class: src.estimators.ewma.EWMA
      params:
        halflife: 20
        vol_ann: 252
    controller:
      class: src.controllers.drawdown_brake.DrawdownBrake
      params: {}
  - name: ewma__trend
    estimator:
      class: src.estimators.ewma.EWMA
      params:
        halflife: 20
        vol_ann: 252
    controller:
      class: src.controllers.trend_filter.TrendFilter
      params: {}
  - name: ewma__cvar_es
    estimator:
      class: src.estimators.ewma.EWMA
      params:
        halflife: 20
        vol_ann: 252
    controller:
      class: src.controllers.cvar_es_targeting.CVaRESTargeting
      params: {}
  - name: ewma__hysteresis
    estimator:
      class: src.estimators.ewma.EWMA
      params:
        halflife: 20
        vol_ann: 252
    controller:
      class: src.controllers.hysteresis_controller.HysteresisController
      params: {}
  - name: ewma__priority
    estimator:
      class: src.estimators.ewma.EWMA
      params:
        halflife: 20
        vol_ann: 252
    controller:
      class: src.controllers.priority_stack_controller.PriorityStackController
      params: {}
  - name: realized_vol__naive
    estimator:
      class: src.estimators.realized_vol.RealizedVol
      params:
        lookback: 20
        vol_ann: 252
    controller:
      class: src.controllers.naive_scaling.NaiveScaling
      params: {}
  - name: realized_vol__constant
    estimator:
      class: src.estimators.realized_vol.RealizedVol
      params:
        lookback: 20
        vol_ann: 252
    controller:
